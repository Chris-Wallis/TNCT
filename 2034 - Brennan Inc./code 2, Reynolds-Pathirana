    },
    {
        "model": "campaign_trail.answer",
        "pk": 42648,
        "fields": {
            "question": 1205,
            "description": "See if we can hire some professional hackers from abroad, sneak them through airport security, and get them to hack into some Brennan linked groups.\n"
