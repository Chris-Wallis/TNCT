    },
    {
        "model": "campaign_trail.answer",
        "pk": 42837,
        "fields": {
            "question": 1217,
            "description": "Let’s organise a network of associates across all fifty states, in preparation for a trip abroad, whilst also getting me a large group of personal protectors.\n"
